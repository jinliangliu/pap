# 环境与密钥：任何 .env 变体都不提交（含 .env.save / .env.local）
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 数据库与索引产物
*.sqlite
*.sqlite3
*.db
data/index/

# 运行时数据
data/uploads/
data/exports/
data/artifacts/
data/chroma/
# 页面上传的知识文档：内容随租户变化，不进版本库（目录扫描用的
# data/knowledge/ 是样例数据，仍然跟踪）
data/knowledge_uploads/
.langgraph_api/
logs/

# 工作区内部数据（代理记忆、缓存），不属于项目代码
.workbuddy/

# 部署记录：由 deploy/sync.sh 在服务器上写入，记录已上线的提交号
.deployed-commit

# 临时预览（无头浏览器截图、本地探针）：看长相用的，不是项目产物
.tmp-preview/

# 连接器插件包：里面写着个人访问令牌，只能本机用，绝不提交
deploy/connector/

# OCR 转出来的源料（PaddleOCR 产物）：可由 PDF 重新生成，不进版本库。
# 要不要入库是知识库那边的事，与仓库无关。
docs/*_by_PaddleOCR-VL-*.md
