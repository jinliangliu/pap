# 应用
APP_NAME=personal-agent-platform
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=[]

# 日志
LOG_LEVEL=INFO
LOG_JSON=false

# 业务数据库（异步驱动）
# PostgreSQL: postgresql+psycopg://user:password@127.0.0.1:5432/personal_agent
# SQLite:     sqlite+aiosqlite:///./data/app.db
#
# 部署到 PostgreSQL 时，这里的账号必须是**普通角色**（NOSUPERUSER NOBYPASSRLS），
# 只给业务表的 DML + 序列权限，不给 DDL。超级用户会直接绕过 Row Level Security，
# 让「数据库层兜底」这道防线整体失效——应用层过滤仍然有效，但只剩一层。
# 建角色与授权语句见 docs/MULTI_TENANCY.md「生产部署」。
# 迁移与 checkpoint 建表用管理账号单独执行，不要复用这个连接串。
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false

# LangGraph 会话状态库（checkpoints / checkpoint_blobs / checkpoint_writes）
# 只支持 PostgreSQL：写操作在 interrupt 处中断，确认请求可能落到另一个进程，
# 必须所有实例共享同一份会话状态。留空表示复用上面的 DATABASE_URL。
CHECKPOINT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/personal_agent
# 连接池上限（每个进程）。表结构由启动时 setup() 幂等创建，不走 Alembic。
CHECKPOINT_POOL_SIZE=5
# 启动时是否执行 LangGraph 的表结构迁移。
# 生产必须为 false：应用角色没有 schema CREATE 权限（RLS 第二道防线的前提），
# 表结构由管理账号离线执行 `python -m scripts.init_checkpointer` 建立。
# 本地开发/测试保持 true。
CHECKPOINT_AUTO_SETUP=true

# 审批
APPROVAL_EXPIRE_SECONDS=300
EXECUTING_STALE_SECONDS=120
MAINTENANCE_INTERVAL_SECONDS=30
MAINTENANCE_ENABLED=true
# 多实例用 PG 事务级 advisory lock 互斥：同一时刻只有一个实例在扫。
# 各实例必须配置相同的 key；单进程部署保持默认即可。
MAINTENANCE_REQUIRE_LEADER=true
MAINTENANCE_ADVISORY_LOCK_KEY=1347375181

# 模型（OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# 工具
TOOL_DEFAULT_TIMEOUT_SECONDS=20
READ_TOOL_RATE_LIMIT_PER_MINUTE=60
WRITE_TOOL_RATE_LIMIT_PER_MINUTE=10

# 限流计数必须跨进程共享：多 worker / 多副本下进程内计数等于把配额乘以进程数。
# auto   : 配了 REDIS_URL 走 Redis，否则退回进程内（仅限本地调试）
# redis  : 强制 Redis，连不上即启动失败
# memory : 强制进程内计数，生产环境会拒绝启动
RATE_LIMIT_BACKEND=auto
REDIS_URL=
REDIS_TIMEOUT_SECONDS=1.0
# Redis 不可用时是否放行。默认 false（fail-closed）：失去全局限流时宁可拒绝。
RATE_LIMIT_FAIL_OPEN=false

# 场站平台。留空表示场站工具以显式 mock 模式运行（结果标注 source=mock）
STATION_PLATFORM_BASE_URL=
STATION_PLATFORM_TIMEOUT_SECONDS=10
STATION_PLATFORM_READ_RETRY_ATTEMPTS=2

# ---------------- 远端 MCP Server（出向：PAP 当客户端） ----------------
# 默认关闭。关闭时不会注册任何 MCP 工具，模型连这些工具存在都不知道。
MCP_ENABLED=false
# Streamable HTTP 端点。同机部署时用回环地址，不要走公网 IP。
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_CONNECT_TIMEOUT_SECONDS=15
# 按租户分配的访问令牌，JSON。没有配置的租户会被直接拒绝——
# 不会回落到别的租户令牌，那等于用别人的身份去读数据。
# 例：MCP_TENANT_TOKENS={"default":"<token>"}
MCP_TENANT_TOKENS={}
# 单次结果回给模型的字符上限，超出截断并标记 truncated。
MCP_MAX_RESULT_CHARS=12000

# ---------------- 对外 MCP 通道（入向：外部宿主把事委派进来，docs/MCP_SERVER.md） ----------------
# 与上面那组方向相反，名字刻意分开：一组是「PAP 去连别人」，一组是「别人来连 PAP」，
# 凭据、超时、暴露面都不同，合成一个开关必然出现「只想关一边」的场景。
# 开启后暴露 /mcp（JSON-RPC + 单次委派 + 句柄查询）。
MCP_INBOUND_ENABLED=false
# 凭据有两条路：
#   1) 个人访问令牌（PAT）—— 正常用法，控制台「访问令牌」页自助签发，
#      审计里能查到「谁下的单」。不需要在本文件里配任何东西。
#   2) 下面的静态令牌 —— 只给单机自测和「表还没建好」的时刻。
#      它对应一个固定主体，所有调用都记在同一个名字下。
# 两条都没有时**不会拒绝启动**：鉴权是 fail-closed，一律 401。
# 这正是「不强制配静态令牌」的理由——强制只会逼着长期留一枚万能令牌。
MCP_INBOUND_TOKEN=
# 静态令牌对应的主体与租户。**必须是平台内已存在的账号**：
# gateway 模式下未知主体一律拒绝，不会自动建号。
# 令牌里不带角色：授权仍以数据库为准，撤角色立即生效。
MCP_INBOUND_SUBJECT=workbuddy-connector
# 留空回落到 DEFAULT_TENANT_ID。
MCP_INBOUND_TENANT=
# 单次委派的同步等待上限（秒）。超时返回 pending + task_id，由调用方续查。
# 刻意远小于 CHAT_TIMEOUT_SECONDS：MCP 客户端会先超时，挂太久只会让用户看到断连。
MCP_INBOUND_WAIT_SECONDS=30
# 用整段 JSON 响应代替 SSE。要推进度事件时改成 false，
# 同时必须在反代上 proxy_buffering off，否则事件会被缓冲到整段才发。
MCP_INBOUND_JSON_RESPONSE=true

# ---------------- 代码沙箱 ----------------
# 平台不执行任何代码：execute_code 工具通过 HTTP 把代码交给外部沙箱。
# 沙箱侧（第一阶段）用 Docker + gVisor，每执行一个一次性容器；部署见 docs/SANDBOX.md。
# 留空则工具不注册，模型看不到该能力（不会出现“能调用但一定失败”的工具）。
SANDBOX_BASE_URL=
# 生产环境配置了 BASE_URL 就必须提供 KEY，否则拒绝启动。
SANDBOX_API_KEY=
# 单个执行的墙钟预算（秒），包含排队与轮询。
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_POLL_INTERVAL_SECONDS=0.5
SANDBOX_MAX_CODE_BYTES=20000
# stdout/stderr 各自上限，超出部分截断并标记 truncated。
SANDBOX_MAX_OUTPUT_CHARS=8000
# 平台侧语言白名单，JSON 数组格式。
SANDBOX_ALLOWED_LANGUAGES=["python","javascript"]
# 默认要求审批：执行任意代码可能产生文件、网络等副作用。
SANDBOX_REQUIRES_APPROVAL=true

# ---------------- 身份与多租户 ----------------
# dev:     允许用 X-Authenticated-Subject 指定主体，缺省回落到 DEV_SUBJECT，仅限本地开发
# gateway: 只接受反代/网关注入的身份头；缺头 401，且不会自动创建陌生身份
# jwt:     本服务自行验签 Bearer Token（HS256），租户与角色来自声明
#
# 只要服务能被本机以外的请求访问（含经 Nginx 反代），就必须设为 gateway 或 jwt，
# 否则任何人都能自带 X-Authenticated-Subject 冒充任意用户。
# APP_ENV=production 时 dev 模式直接拒绝启动。
AUTH_MODE=dev

# 没有可用租户声明时的兜底租户（dev 模式也用它开户）。
DEFAULT_TENANT_ID=default
# 平台管理租户：只有它的 platform_admin 成员能调用 /api/v1/admin/*。
PLATFORM_TENANT_ID=platform
DEV_SUBJECT=dev-user
DEV_STATION_ID=station-001

# auth_mode=jwt 时必填，至少 32 字符。
# 共用短密钥等于把「我是谁、我在哪个租户」交给任何人伪造。
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=30

# X-Authenticated-Tenant 只能作为「切换到哪个组织」的申请：
# 服务端一定会再校验成员关系，不属于该租户时返回 403（而不是默默按请求头执行）。
TENANT_HEADER_OVERRIDE_ENABLED=true
# 写租户表时缺少上下文是否直接失败。仅在数据修复/迁移时临时关闭。
TENANT_STRICT_WRITES=true
# 租户配额与工具策略的进程内缓存秒数。管理接口写入后会主动失效本进程缓存，
# 多实例部署时其他实例最多晚一个周期。
TENANT_POLICY_CACHE_SECONDS=5.0

# 单租户未单独配置配额时的平台默认值。
# 注意：这是「每个租户」的上限，不是全平台总量；单租户刷量不会拖垮其他租户。
DEFAULT_DAILY_CHAT_REQUESTS=5000
DEFAULT_TENANT_TOOL_CALLS_PER_MINUTE=600

# ---------------- 附件对象存储 ----------------
# 目录内按 tenants/<tenant>/users/<user>/artifacts/ 分前缀；
# 对象键不是权限，下载一律经服务端按 (tenant, user) 校验后再读。
ARTIFACT_STORAGE_DIR=./data/artifacts
ARTIFACT_MAX_BYTES=10485760

# 知识库
# 切片存 PostgreSQL 的 documents / document_chunks，运行时不再读本地 JSON；
# 各实例按索引版本号热加载，重新入库不需要重启。
KNOWLEDGE_DIR=./data/knowledge
# 页面上传的文档落盘位置。**必须与 KNOWLEDGE_DIR 分开**：
# 目录同步把「目录里没有的」当作已删除，混在一起会把上传的文档一起清掉。
KNOWLEDGE_UPLOAD_DIR=./data/knowledge_uploads
# 仅 scripts.ingest_knowledge --export-json 的快照路径
KNOWLEDGE_STORE_FILE=./data/index/chunks.json
# 索引版本轮询间隔（秒）：多进程在不重启的前提下感知重新入库
KNOWLEDGE_INDEX_REFRESH_SECONDS=5.0
KNOWLEDGE_TOP_K=4
# 绝对下限：只对正分生效（小语料下 BM25 的 IDF 可能全为负）。
# 由于 BM25 分数没有绝对量纲，它基本只是兜底，真正起作用的见下一项。
KNOWLEDGE_MIN_SCORE=0.05
# 相对下限：低于第一名这个比例的候选直接丢弃，0 表示关闭。
# 语料从 7 个切片涨到 700 个时，分数的绝对值尺度会变，比例不会。
KNOWLEDGE_MIN_RELATIVE_SCORE=0.3
# 语义重筛：把 BM25 召回池扩到 CANDIDATES 条，交给当前生效的 chat 模型
# 判「能否部分回答问题」，剔除字面撞词的假阳性。不需要 embedding 端点。
# 设 false 完全回到纯 BM25，检索链路不再发起任何模型调用。
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_RERANK_CANDIDATES=12
# 超时或模型异常会自动回落 BM25，不会让检索报错。
KNOWLEDGE_RERANK_TIMEOUT_SECONDS=8.0
# 答复归纳：命中片段后由 chat 模型整理成「一句一事」的答复，而不是把
# 前 TOP_K 条切片原样拼给用户。设 false 回到原文摘录（同一次检索，
# 只是不做表述整理）；归纳失败也会自动回落到摘录，不会变成空答复。
KNOWLEDGE_SUMMARY_ENABLED=true
KNOWLEDGE_SUMMARY_TIMEOUT_SECONDS=20.0
# 字段加权：把标题（含文件名）与 section 的分词重复 N 次并入 BM25 索引，
# 让「查询词只在标题里、正文一次都没出现」的片段也能被召回。
# 0 = 只索引正文，用 scripts/eval_knowledge.py --no-boost 做 A/B 对照。
KNOWLEDGE_TITLE_BOOST=2
KNOWLEDGE_SECTION_BOOST=1
# 查询侧领域同义词扩展：廉价补丁，只覆盖登记过的词对，不是语义检索。
# 默认关闭；开启前后用 scripts/eval_knowledge.py --expand 量过再决定。
KNOWLEDGE_QUERY_EXPANSION_ENABLED=false
KNOWLEDGE_MAX_FILE_BYTES=5242880
# 单篇文档切片上限：超了直接报错要求拆分，不静默截断。
# 这不是质量阈值而是容量阈值，取值由真实的现行国标决定：400 卡住 448 片的
# GB/T 3836.1，800 卡住 973 片的 GB/T 3836.4（56.8 万字，平均 584 字/片，
# 颗粒度正常）。真正该拆的是「切碎了」——平均每片几十个字。
# 线上通常不用改这里：控制台「运行配置」的 knowledge.max_chunks_per_document
# 优先于本行，且改完即时生效、不用重启。
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=2000

# ---------------- 可观测性 ----------------
# 自研观测（控制台「观测」页）：进程内埋点 + 落库，数据留在自己的库里、按租户隔离。
# 开关的权威在库里（platform_settings 的 observability.enabled）：管理员在
# 控制台「运行配置 → 观测」改，立刻生效、不用重启，默认开启。
# 这里只是**首次默认值**：库里还没有这条记录时才读它。
# false 时零写入、零外发（含 OTLP）、业务侧零额外开销。
OBS_ENABLED=true
# full：存完整原文（开发期用这个）；summary：200 字摘要；off：只记结构。
OBS_CAPTURE_CONTENT=full
OBS_SAMPLE_RATE=1.0
OBS_RETENTION_DAYS=14
OBS_KEEP_ERROR_DAYS=30

# OTLP 出口（可选）。仅在观测开关打开时导出；留空则不外发。
OTEL_SERVICE_NAME=personal-agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=

# LangSmith 已于 2026-11 退役。**不要再配置 LANGSMITH_* / LANGCHAIN_TRACING_V2**：
# langchain-core 会读这两个变量自动上报调用链，是一条未声明的外发通道。
# 需要看调用链请用控制台「观测」页，数据留在自己的库里。

# ---------------- 模型服务 ----------------
# 通常不需要在这里配：平台管理员在控制台「运行配置 → 文字模型服务」
# 添加供应商并设为使用中之后，模型、密钥、Base URL 都以那张表为准。
# 下面前三个键只是「一条供应商都没有」时的兜底，行为与升级前一致。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash     # 以 GET /models 的实际返回为准

# ---------------- OCR（走 MCP） ----------------
# 识别能力不在平台内：本机 OCR 服务以 MCP 暴露 ocr_file(file_path)，
# 平台把附件句柄解析成绝对路径后调它。所以 OCR 服务必须与平台同机（或共享挂载）。
# 没有「启用 OCR」开关：地址为空就是没接，调用会明确报未配置。
# OCR_MCP_URL=http://127.0.0.1:4499/mcp
# OCR_MCP_TOKEN=                  # 该服务不鉴权时留空，表示不发 Authorization 头
# OCR_MCP_TIMEOUT_SECONDS=120     # PDF 逐页渲染，随页数线性增长
# OCR_MAX_TEXT_CHARS=40000        # 回填给模型的文本上限，超出截断并注明
# OCR_ATTACHMENT_DIR=./data/uploads
# OCR_MAX_IMAGE_BYTES=10485760
# OCR_MAX_PDF_BYTES=20971520

# ---------------- 智能体推理回路 ----------------
# 单次请求内「工具执行 → 重新规划」的轮次上限。
# 设为 1 等于关闭回路（工具结果直接作答，不再回灌模型）。
# AGENT_MAX_TOOL_STEPS=3

# Docker Compose 使用；不要提交真实密码
POSTGRES_PASSWORD=change-me-in-env

# 长期记忆：跨会话沉淀稳定事实，每轮注入规划 prompt。
# 关掉后接口仍可读写（历史还在），但不再注入。
MEMORY_ENABLED=true

# 自动抽取：一轮回答落地后，用同一份文字模型判断有没有值得长期记住的事实。
# 抽出来的是候选（默认未确认），在控制台「记忆」页确认或删除后才会被当成确定信息。
# 关掉只是不再新增候选，已有记忆照常注入。
MEMORY_EXTRACT_ENABLED=true

# 梦境（dreaming）：离线用会话原文校验自动候选，产出「纠错 / 合并 / 下架」建议，
# 人工确认后才生效。不做成每轮后台任务——按需触发更划算。
#
# 注意这三个是**平台默认值**，不是硬编码：租户可以在记忆页「梦境配置」里覆盖
# （存 tenant_memory_settings）。平台把 ENABLED 关掉是急停，租户无法自行打开；
# 天数与上限则允许租户改，0 表示跟随这里的默认值。
MEMORY_DREAM_ENABLED=true
# 证据窗口（天）与单次梦境上限。每条记忆要一次模型调用，值越大脚本跑得越久。
MEMORY_DREAM_DAYS=30
MEMORY_DREAM_MAX_PER_RUN=20

# ---------------- 长对话上下文 ----------------
# 每轮把最近几轮原文与一份更早对话的摘要注入规划 prompt；超出预算时压缩。
# 关掉等于回到「每轮只带当前这一条」，排查「是不是历史把模型带偏了」时用。
CONTEXT_ENABLED=true
# 模型上下文窗口。供应商配置里填了 context_window 就以那里为准，这里只是兜底。
# 默认 32000 刻意保守：宁可早压，不要撞上限（早压少看几轮原文，撞上限整轮失败）。
# CONTEXT_WINDOW_TOKENS=32000
# 实测 token 达到窗口的这个比例时触发压缩；超过 HARD 比例直接硬截断，不等摘要。
# 两者顺序不能反：压缩线高于硬截断线时，压缩永远不会发生，只剩无声的截断。
# CONTEXT_COMPACT_RATIO=0.6
# CONTEXT_HARD_RATIO=0.85
# 摘要生成的独立时限。聊天总时限只包住执行图，压缩在它之前跑，必须单独限时。
# CONTEXT_TIMEOUT_SECONDS=20

# 技能：控制台维护的作业指令 + 触发词 + 工具白名单。
# 命中方式只有两种：消息以 /技能名 开头，或包含任一触发词（确定性匹配，不调模型）。
# 关掉后页面照常可编辑，但不再注入规划 prompt——排查「某个技能把模型带偏了」时用。
SKILLS_ENABLED=true
