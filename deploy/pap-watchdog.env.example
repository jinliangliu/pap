# /etc/pap-watchdog.env —— 巡检告警配置（可选，全部有默认值）
#
# 这个文件与业务 .env 分开：巡检脚本不需要模型密钥和数据库口令，
# 也不该在它被攻破时连带泄露这些。
#
# 改完不用重启：下一分钟的巡检就会读到新值。

# ---------------- 检查对象 ----------------

# 就绪检查地址。必须是本机回环，脚本会主动绕开代理。
WATCHDOG_BASE_URL=http://127.0.0.1:8000

WATCHDOG_SERVICE=personal-agent-platform.service
WATCHDOG_DB_CONTAINER=personal-agent-postgres

# MCP Server 的宿主机地址，只做 TCP 连通性探测。留空字符串可跳过。
WATCHDOG_MCP_ADDR=127.0.0.1:8765

# ---------------- 阈值 ----------------

WATCHDOG_DISK_PATH=/
WATCHDOG_DISK_MAX_PERCENT=85

# 可用内存下限（MiB）。低于此值触发告警。
WATCHDOG_MEM_MIN_AVAILABLE_MB=512

# 近 N 行请求里 5xx 超过多少条算异常。
WATCHDOG_ACCESS_LOG=/var/log/nginx/access.log
WATCHDOG_ACCESS_LOG_LINES=1000
WATCHDOG_HTTP_5XX_MAX=20

# ---------------- 告警节奏 ----------------

# 连续失败多少次才报警。1 = 立刻报，代价是每次服务重启都会响一次。
WATCHDOG_FAIL_THRESHOLD=2

# 同一个问题多久重复提醒一次（秒）。1800 = 半小时。
WATCHDOG_REPEAT_SECONDS=1800

WATCHDOG_TIMEOUT_SECONDS=8
# WATCHDOG_STATE_FILE=/var/lib/pap-watchdog/state.json

# ---------------- 投递通道（二选一或都填） ----------------

# 群机器人 Webhook。类型可选：wecom / dingtalk / feishu / slack / generic
# 企业微信示例：
#   WATCHDOG_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   WATCHDOG_WEBHOOK_TYPE=wecom
WATCHDOG_WEBHOOK_URL=
WATCHDOG_WEBHOOK_TYPE=generic

# 自定义命令，告警正文从 stdin 传入。适合接邮件或短信网关：
#   WATCHDOG_ALERT_CMD=mail -s "PAP 告警" ops@example.com
# 命令以 root 身份执行，只填你自己写的脚本，别直接拼外部输入。
WATCHDOG_ALERT_CMD=
