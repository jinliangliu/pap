[Unit]
Description=Personal Agent Platform 巡检与告警
Documentation=file:///personal-agent-platform/docs/MONITORING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root

# 用系统 python 而不是项目 venv：巡检脚本只用标准库，
# 并且在「venv 坏了 / 依赖装坏」时仍然必须能跑。
ExecStart=/usr/bin/python3 /personal-agent-platform/scripts/watchdog.py

# 告警通道写在 /etc/pap-watchdog.env，与业务 .env 分开：
# 巡检脚本不该拿到模型密钥和数据库口令。
EnvironmentFile=-/etc/pap-watchdog.env

# systemd 侧再兜一层超时，防止脚本卡在某个网络调用上。
TimeoutStartSec=120

# 巡检失败时不把单元标成 failed：每分钟一次，failed 会刷满
# systemctl --failed，反而掩盖真正挂掉的单元。脚本本身始终以 0 退出，
# 失败通过告警和 journal 里的 watchdog_checks 表达。

Nice=10
IOWeight=10

# 巡检要读 docker.sock 和 systemd 的 socket，都在 /run 下，
# 所以只把 /usr、/etc 挂成只读（full），不用 strict——strict 连 /run 也会锁，
# 会把「查数据库容器状态」这类只读探测一起挡掉。
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
NoNewPrivileges=true
