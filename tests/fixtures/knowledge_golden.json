{
  "version": 1,
  "corpus": "data/knowledge 目录扫描语料；不含页面上传文档",
  "note": "expect_found=false 表示库里本就没有答案，正确行为是返回资料不足。relevant 用 source_path 精确匹配。新增文档或改动切片规则后必须重跑本评测集，不要直接改期望值迁就结果。",
  "cases": [
    {
      "id": "retrieval-algorithm",
      "query": "知识库使用什么检索方案",
      "expect_found": true,
      "relevant": ["inbox/agent-platform-overview.md", "projects/项目规划.md", "notes/平台能力说明.md"],
      "note": "BM25 关键词检索"
    },
    {
      "id": "tokenizer",
      "query": "中文分词用哪个组件",
      "expect_found": true,
      "relevant": ["inbox/agent-platform-overview.md", "projects/项目规划.md"],
      "note": "jieba"
    },
    {
      "id": "approval-ttl",
      "query": "审批有效期是多少秒",
      "expect_found": true,
      "relevant": ["notes/approval_policy.md"],
      "note": "300 秒"
    },
    {
      "id": "approval-preview",
      "query": "写操作前要先生成什么",
      "expect_found": true,
      "relevant": ["notes/approval_policy.md", "inbox/agent-platform-overview.md", "notes/平台能力说明.md"],
      "note": "预览"
    },
    {
      "id": "idempotency-key",
      "query": "幂等键在哪里使用",
      "expect_found": true,
      "relevant": ["notes/approval_policy.md", "notes/平台能力说明.md"],
      "note": "已知缺陷：title 里的『使用说明』让同一份文档占满 top4，把真正含『幂等键』的审批策略挤出榜单。基线保留此 miss 用于追踪结果去重问题，不要改期望值迁就结果"
    },
    {
      "id": "filename-only-term",
      "query": "approval_policy",
      "expect_found": true,
      "relevant": ["notes/approval_policy.md"],
      "note": "查询词只出现在文件名(title)，正文完全没有。字段加权应召回，--no-boost 应返回 0 条"
    },
    {
      "id": "security-requirements",
      "query": "平台安全要求有哪些",
      "expect_found": true,
      "relevant": ["inbox/agent-platform-overview.md"],
      "note": "安全要求小节"
    },
    {
      "id": "no-secrets-in-kb",
      "query": "密钥能不能写进知识库",
      "expect_found": true,
      "relevant": ["inbox/agent-platform-overview.md", "notes/使用说明.md", "manuals/操作手册.txt"],
      "note": "不得写入"
    },
    {
      "id": "supported-formats",
      "query": "第一阶段支持哪些资料格式",
      "expect_found": true,
      "relevant": ["notes/使用说明.md", "projects/项目规划.md"],
      "note": "Markdown 与 TXT"
    },
    {
      "id": "knowledge-dir",
      "query": "知识资料放在哪个目录",
      "expect_found": true,
